// Enable Singularity support
singularity {
    enabled = true
    autoMounts = true
    cacheDir = '/net/bmc-lab3/data/bcc/charliew/.singularity_cache'
}

// Enable conda for other processes
conda {
    enabled = true
    useMamba = true
    cacheDir = '/net/bmc-lab3/data/bcc/charliew/.conda/pkgs'
}

// Process configuration
process {
    withName: 'CHOPPER' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/NanoFilt'
        cpus = 4
        memory = '8 GB'
    }
    withName: 'DOWNSAMPLE_FASTQ' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/nf-core_v24'
        cpus = 1
        memory = '4 GB'
    }
    withName: 'FLYE_PREFLIGHT' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/flye_2.9.5'
        cpus = 4
        memory = '8 GB'
    }
    withName: 'PARSE_PREFLIGHT_RESULTS' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/nf-core_v24'
        cpus = 1
        memory = '2 GB'
    }
    withName: 'NANOPLOT' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/NanoFilt'  // Use NanoFilt env
        cpus = 2
        memory = '4 GB'
    }
    withName: 'NANOPLOT_ORIGINAL' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/NanoFilt'  // Use NanoFilt env
        cpus = 2
        memory = '4 GB'
    }
    withName: 'PARSE_NANOSTATS' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/nf-core_v24'
        cpus = 1
        memory = '2 GB'
    }
    withName: 'FILTER_ASSEMBLY_CANDIDATES' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/nf-core_v24'
        cpus = 1
        memory = '2 GB'
    }
    withName: 'FLYE' {
        conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/flye_2.9.5'  // or your flye environment
        cpus = 8
        memory = '32 GB'
        time = '24h'  // Flye can take a long time
    }
    withName: 'TRANSGENE_BLAST' {
    container = 'ncbi/blast:latest'
    cpus = 2
    memory = '4 GB'
    time = '2h'
    }
    withName: 'PARSE_TRANSGENE_BLAST' {
    conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/nf-core_v24'
    cpus = 1
    memory = '2 GB'
    time = '30m'
    }
    withName: 'GATHER_ASSEMBLY_STATS' {
    conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/nf-core_v24'
    cpus = 1
    memory = '2 GB'
    time = '30m'
    }
    withName: 'SIMPLE_RESULTS_SUMMARY' {
    conda = '/net/bmc-lab3/data/bcc/charliew/.conda/envs/nf-core_v24'
    cpus = 1
    memory = '2 GB'
    time = '30m'
    }
}

// Parameters
params {
    input_fastq = null
    name = null
    samples = null
    outdir = "results"
    genome_size = "10m"
    
    // Mode configuration
    mode = null
    default_mode = "scan"
    
    // Size filtering parameters (for scan mode)
    min_quality = 10
    size_ranges = [
        [min: 30000, max: null,  name: "30k_Plus"],
        [min: 40000, max: null,  name: "40k_Plus"],
        [min: 50000, max: null,  name: "50k_Plus"]
    ]
    
    // Downsampling parameters (for downsample mode)
    downsample_rates = [0.25, 0.5, 0.75]
    
    // Bootstrap parameters (for bootstrap mode)
    fraction = 0.75        // Default fraction for bootstrap
    replicates = 10        // Default number of replicates
    
    // Transgene library configuration
    transgene_library = "${projectDir}/transgenes/transgene_library.csv"
    transgene_dir = "${projectDir}/transgenes"
    default_transgene = "A-vector_herceptin_pEY345"
    transgene = null
}

// Execution reports
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']